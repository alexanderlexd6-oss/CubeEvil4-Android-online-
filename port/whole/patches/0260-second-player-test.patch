 cEmMgr EmMgr;
+
+/* PORT (patch 0260): second player test (split screen / online), the first experiment of port/docs/split-online-plan.md.
+   pPL2 is a second Leon, created while the app sends a controller on channel 1 (re4_pad2_connected). The game reads the
+   globals pPL (the player) and Key (the buttons) everywhere, so the second Leon only runs inside re4_pl2_move with those
+   two swapped to its own (Key2, pad.cpp, from Joy[1]) and put back right after. Not done yet: the camera, the enemies'
+   targets (pTarget = pPL), the HUD, the inventory and life (shared, pG), cutscenes. */
+extern KEY Key2;
+extern "C" int re4_pad2_connected(void);
+
+void re4_pl2_move()
+{
+    if (!re4_pad2_connected()) {
+        if (pPL2) {
+            cPlayer* gone = pPL2;
+            pPL2 = 0;
+            EmMgr.destroy(gone);
+        }
+        return;
+    }
+    if (!pPL2) {
+        if (pPL && pPL->isAlive() && !StaFlagChk(pG, STA_SUSPEND)) {
+            cPlayer* first = pPL;
+            cEm* e = EmMgr.create(0);
+            pPL = first;
+            if (e) {
+                pPL2 = (cPlayer*) e;
+                e->pos = first->pos;
+                e->pos.x += 200.0f;
+                e->ang = first->ang;
+            }
+        }
+        return;
+    }
+    if (!pPL2->isAlive()) {
+        pPL2 = 0;
+        return;
+    }
+    if (!SpfFlagChk(pG, SPF_PL) && (pPL2->be_flag & 0x20) &&
+        (!StaFlagChk(pG, STA_SUSPEND) || (pPL2->be_flag & 0x800))) {
+        cPlayer* first = pPL;
+        KEY firstKey = Key;
+        pPL = pPL2;
+        Key = Key2;
+        pPL2->move();
+        Key2 = Key;
+        Key = firstKey;
+        pPL = first;
+    }
+}
