 // The split object's .rodata is 8-aligned and 4 bytes longer (padding after the last string).
 asm(".section .rodata; .balign 8");
+
+/* PORT (patch 0260): Key2, the second player's buttons, made from Joy[1] the way Key is made from Joy[0] (same key table,
+   the same pairs of opposite directions cancel). Without the repeat timers: rep / rep2 are the new presses. */
+KEY Key2;
+
+void re4_key2_build()
+{
+    static const int pairs[8][2] = { { 0, 1 }, { 2, 3 }, { 24, 25 }, { 27, 26 }, { 35, 34 }, { 32, 33 }, { 14, 15 }, { 37, 36 } };
+    u64 on = 0;
+    u64 bit;
+    int i;
+
+    if (SpfFlagChk(pG, SPF_KEY)) {
+        Key2.on = 0;
+        Key2.old = 0;
+        Key2.trg = 0;
+        Key2.rel = 0;
+        Key2.rep = 0;
+        Key2.rep2 = 0;
+        Key2.stickX = 0;
+        Key2.stickY = 0;
+        Key2.substickX = 0;
+        Key2.substickY = 0;
+        Key2.triggerLeft = 0;
+        Key2.triggerRight = 0;
+        return;
+    }
+    for (i = 0, bit = 1; i < 64; bit <<= 1, i++) {
+        if (Joy[1].on & Key_type_tbl[pSys->pad_type][i]) {
+            on |= bit;
+        }
+    }
+    on &= ~KEY_BIT(34);
+    for (i = 0; i < 8; i++) {
+        if ((on & KEY_BIT(pairs[i][0])) && (on & KEY_BIT(pairs[i][1]))) {
+            on &= ~KEY_BIT(pairs[i][0]);
+            on &= ~KEY_BIT(pairs[i][1]);
+        }
+    }
+    Key2.trg = (Key2.old ^ on) & on;
+    Key2.rel = (Key2.old ^ on) & Key2.old;
+    Key2.old = on;
+    Key2.on = on;
+    Key2.rep = Key2.trg;
+    Key2.rep2 = Key2.trg;
+    Key2.stickX = Joy[1].stickX;
+    Key2.stickY = Joy[1].stickY;
+    Key2.substickX = Joy[1].substickX;
+    Key2.substickY = Joy[1].substickY;
+    Key2.triggerLeft = Joy[1].triggerLeft;
+    Key2.triggerRight = Joy[1].triggerRight;
+    Key2.analogA = 0;
+    Key2.analogB = 0;
+}
